#!/bin/bash

# Transcriber Global Launch Script
# This script ensures dependencies are met and then launches the application.

# 1. Get the directory where this script is located
PROJECT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
cd "$PROJECT_DIR"

# 2. Virtual Environment Check
if [ -d "$HOME/venv" ]; then
    source "$HOME/venv/bin/activate"
elif [ -d "$PROJECT_DIR/venv" ]; then
    source "$PROJECT_DIR/venv/bin/activate"
elif [ -d "$PROJECT_DIR/.venv" ]; then
    source "$PROJECT_DIR/.venv/bin/activate"
fi

# 3. Dependency Check
# We use importlib.metadata (standard in Python 3.8+) to check dependencies
MISSING_DEPS=$(python3 -c "
import importlib.metadata
import sys

try:
    with open('requirements.txt', 'r') as f:
        requirements = [line.strip().split('==')[0].split('>=')[0].split('<=')[0].strip() 
                       for line in f if line.strip() and not line.startswith('#')]
    
    missing = []
    for req in requirements:
        try:
            importlib.metadata.version(req)
        except importlib.metadata.PackageNotFoundError:
            missing.append(req)
    
    if not missing:
        print('OK')
    else:
        print(f'Missing: { \", \".join(missing) }')
except Exception as e:
    print(e)
")

if [ "$MISSING_DEPS" != "OK" ]; then
    echo "Error: Missing required Python libraries."
    echo "------------------------------------------------"
    echo "$MISSING_DEPS"
    echo "------------------------------------------------"
    echo "Please run: pip install -r requirements.txt"
    exit 1
fi

# 4. Launch the application
python3 main.py
